# ===================================================
# CRISIS GROUND TRUTH DETECTOR - UNIFIED ENVIRONMENT CONFIG EXAMPLE
# ===================================================

# --- BACKEND SERVER SETTINGS ---
PORT=5000
NODE_ENV=development

# --- DATABASE CONFIGURATION ---
# Local MongoDB connection (running locally on port 27017)
MONGO_URI=mongodb://127.0.0.1:27017/crisis_detector

# If using MongoDB Atlas in the cloud, replace with your URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crisis_detector?retryWrites=true&w=majority

# --- AUTHENTICATION & SECURITY ---
JWT_SECRET=crisis_detector_jwt_secret_dev_2026_super_key
CLIENT_URL=http://localhost:5173

# --- FRONTEND CLIENT SETTINGS (Vite) ---
# Base API URL used by Axios in frontend
VITE_API_URL=http://localhost:5000/api

# WebSocket Server URL used by Socket.IO client in frontend
VITE_SOCKET_URL=http://localhost:5000

# Default Map Center coordinates (fallback: Pune, India)
VITE_DEFAULT_LAT=18.5204
VITE_DEFAULT_LNG=73.8567
